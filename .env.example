# 复制本文件为 .env 并填入你的配置（LLM_API_KEY 必填）
# 任何 OpenAI 兼容接口都可用：改 base_url / model 即可

# ── 智谱 bigmodel 开放平台（默认）──
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4-flash
LLM_API_KEY=把你的key粘贴到这里

# ── Z.ai 用户改用 ──
# LLM_BASE_URL=https://api.z.ai/api/paas/v4/
# LLM_MODEL=glm-4.6

# 注意：模型需要支持 function calling（工具调用）。
# 若提示模型不存在，请到对应平台的模型列表页查可用型号后修改 LLM_MODEL。

# 界面语言（zh / English）：影响 CLI 输出、日志与 Streamlit 控制台；
# 也可在控制台页面内的侧边栏切换。发给模型的提示词保持中文。
MINI_LANG=zh
